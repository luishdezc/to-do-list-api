#!/bin/bash
# Se ejecuta UNA vez, en el primer arranque de la EC2.
# Terraform reemplaza github_repo, db_secret_id y region (ver main.tf).
set -euxo pipefail

REPO="${github_repo}"

# --- Paquetes ---------------------------------------------------------------
dnf install -y git unzip python3.11 python3.11-pip || dnf install -y git unzip python3-pip
dnf install -y postgresql16 || dnf install -y postgresql15 || true   # cliente psql

# --- Configuracion de la app --------------------------------------------------
mkdir -p /opt/todo/releases
cat > /opt/todo/app.env <<EOF
PORT=5000
DB_SECRET_ID=${db_secret_id}
AWS_DEFAULT_REGION=${region}
EOF

# /opt/todo/current es un symlink a la version activa (lo cambia deploy.sh)
cat > /etc/systemd/system/todo.service <<'UNIT'
[Unit]
Description=To-do list API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/todo/current
EnvironmentFile=/opt/todo/app.env
EnvironmentFile=-/opt/todo/version.env
ExecStart=/opt/todo/current/venv/bin/python /opt/todo/current/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable todo

# --- Primer despliegue ---------------------------------------------------------
# Script de deploy (el mismo que usa GitHub Actions)
curl -fsSL --retry 5 -o /usr/local/bin/todo-deploy \
  "https://raw.githubusercontent.com/$REPO/main/scripts/deploy.sh"
chmod +x /usr/local/bin/todo-deploy

# Ultimo release publicado; si no hay ninguno, la rama main
LATEST=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])') || LATEST=""

if [ -n "$LATEST" ]; then
  /usr/local/bin/todo-deploy "$REPO" "$LATEST" || /usr/local/bin/todo-deploy "$REPO" main
else
  /usr/local/bin/todo-deploy "$REPO" main
fi
